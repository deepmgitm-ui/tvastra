    "product-tabs": {
      "type": "product-tabs",
      "blocks": {
        "description": {
          "type": "description",
          "settings": {
            "heading": "Product description"
          }
        },
        "additional-information": {
          "type": "liquid",
          "settings": {
            "heading": "Additional information",
            "tab_content": "<table class=\"table additional-information\"><tbody><tr><th>Name</th><td>{{ product.title }}</td></tr><tr><th>SKU</th><td>{{ product.selected_or_first_available_variant.sku }}</td></tr>{% if product.vendor != blank %}<tr><th>Vendor</th><td>{{ product.vendor }}</td></tr>{% endif %}{% for option in product.options_with_values %}<tr><th>{{ option.name }}</th><td>{{ option.values | join: ', ' }}</td></tr>{% endfor %}</tbody></table>"
          }
        },
        "shipping-return": {
          "type": "custom",
          "settings": {
            "heading": "Shipping & return",
            "tab_content": "<h6 class=\"alt-font\">Returns policy</h6><ul><li>Free shipping on all products</li><li>Easy 7 days returns and exchanges</li></ul><h6 class=\"alt-font\">Shipping policy</h6><p>Tvastra Fit offers reliable shipping across India. Orders are processed within 1–3 business days and delivery typically takes 3–7 business days depending on your location.</p>",
            "content_page": ""
          }
        },
        "reviews": {
          "type": "reviews",
          "disabled": true,
          "settings": {
            "heading": "Product reviews",
            "custom_liquid": ""
          }
        }
      },
