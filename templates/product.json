            "offers_footer": "Verified checkout with Razorpay"
          }
        },
        "short_description": {
          "type": "short_description",
          "settings": {
            "liquid_code": "{{product.metafields.custom.short_description}}"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
