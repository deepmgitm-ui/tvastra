            "shipping_text": "<p>Free return within <strong>30 days</strong> of purchase.</p>"
          }
        },
        "trust-badge": {
          "type": "trust-badge",
          "settings": {
            "trust_badge_img": "shopify://shop_images/Screenshot_2024-08-30_at_1.31.00_PM-removebg-preview.png",
            "trust_badge_width": 310,
            "trust_badge_text": "",
            "trust_badge_position": "flex-column",
            "text_alignment": "start"
          }
        },
        "product-usp": {
          "type": "product-usp",
          "settings": {
            "icon_class1": "bi bi-truck",
            "usp_text1": "Free shipping",
            "usp_link1": "",
            "icon_class2": "bi bi-chat-text",
            "usp_text2": "Reliable support",
            "usp_link2": "",
            "icon_class3": "bi bi-bag-check",
            "usp_text3": "Safe and Secure Payments",
            "usp_link3": "",
            "usp_alignment": "center"
          }
        },
        "live-visitors": {
          "type": "live-visitors",
          "settings": {
            "visitors_text": "[visitors] People's Eyes On this",
            "visitors": 130,
            "visitors_time": 10
          }
        },
        "addon-buttons": {
          "type": "addon-buttons",
          "settings": {
            "show_compare": false,
            "show_question": false,
            "show_social_share": true
