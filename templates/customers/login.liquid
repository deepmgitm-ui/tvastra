{%- section 'breadcrumb' -%}

<style>
  .tvastra-login-page {
    padding: 42px 0 64px;
    background: #fbfaf8;
  }

  .tvastra-login-page__card {
    width: min(100%, 460px);
    margin: 0 auto;
    padding: 30px 24px;
    border: 1px solid rgba(16, 16, 16, 0.1);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 18px 44px rgba(16, 16, 16, 0.06);
    text-align: center;
  }

  .tvastra-login-page__eyebrow {
    margin: 0 0 8px;
    color: #9a7934;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .tvastra-login-page__title {
    margin: 0;
    color: #101010;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.16;
  }

  .tvastra-login-page__text {
    margin: 12px auto 22px;
    color: #6f665f;
    font-size: 14px;
    line-height: 1.55;
  }

  .tvastra-login-page__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    width: 100%;
    border: 1px solid #101010;
    border-radius: 999px;
    background: #101010;
    color: #fff !important;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .tvastra-login-page__button:hover {
    background: #2a2724;
    transform: translateY(-1px);
  }

  .tvastra-login-page__note {
    margin: 14px 0 0;
    color: #8b837c;
    font-size: 12px;
    line-height: 1.45;
  }

  @media (max-width: 767px) {
    .tvastra-login-page {
      padding: 26px 14px 46px;
    }

    .tvastra-login-page__card {
      padding: 24px 18px;
    }

    .tvastra-login-page__title {
      font-size: 23px;
    }
  }
</style>

<div class="tvastra-login-page">
  <div class="container">
    <div class="tvastra-login-page__card">
      <p class="tvastra-login-page__eyebrow">Tvastra account</p>
      <h1 class="tvastra-login-page__title">Sign in with mobile OTP</h1>
      <p class="tvastra-login-page__text">
        Continue to view your account, saved details and order updates.
      </p>
      <a
        href="{{ routes.account_url }}"
        class="tvastra-login-page__button"
        data-no-page-transition
        data-tvastra-kwikpass-account
        aria-label="account"
        onclick="if (window.KP_LOGIN_SDK_INSTANCE && typeof window.KP_LOGIN_SDK_INSTANCE.handleKpLogin === 'function') { event.preventDefault(); window.KP_LOGIN_SDK_INSTANCE.handleKpLogin(); return false; }"
      >
        Continue with OTP
      </a>
      <p class="tvastra-login-page__note">
        The secure OTP popup will open automatically. Tap the button if it needs a second.
      </p>
    </div>
  </div>
</div>
