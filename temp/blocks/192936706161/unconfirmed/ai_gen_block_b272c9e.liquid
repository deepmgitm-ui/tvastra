{% doc %}
  @prompt
    Add a premium product-card video feature to my older Hongo 1.4 Shopify theme. Use the product metafields product.metafields.custom.card_video and product.metafields.custom.popup_video, which are Shopify video file references. In the existing product-card/grid-item markup, render the card_video as an absolutely positioned muted autoplay looping inline video over the product image, using the product card media wrapper as the positioned parent. If popup_video exists, render a “▶ Watch Full Video” button below the product title and price. Clicking it should open a full-screen dark blurred lightbox with a native-controls video, using unique IDs based on the product ID. Add vanilla JavaScript only, with smooth fade-in/fade-out, close button, backdrop click, Escape-key close, and immediate pause/reset when closing. Avoid duplicate event listeners and avoid changing unrelated product-card behavior. Use Shopify video file-reference sources rather than assuming a direct .value.url property. Make the feature work in the existing vintage Liquid product-card structure, not as a standalone homepage section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign card_video = product.metafields.custom.card_video.value %}
{% assign popup_video = product.metafields.custom.popup_video.value %}
{% assign video_id = 'product-video-' | append: product.id %}
{% style %}
  .ai-product-video-feature-{{ ai_gen_id }} { display:block; position:relative; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; }
  .ai-product-video-feature-{{ ai_gen_id }}__media { position:relative; width:100%; }
  .ai-product-video-feature-{{ ai_gen_id }}__card-video { position:absolute; inset:0; z-index:2; width:100%; height:100%; object-fit:cover; pointer-events:none; }
  .ai-product-video-feature-{{ ai_gen_id }}__watch { display:inline-flex; align-items:center; gap:6px; margin-top:{{ block.settings.button_spacing }}px; padding:8px 12px; border:1px solid {{ block.settings.button_color }}; background:transparent; color:{{ block.settings.button_color }}; font:inherit; font-size:13px; line-height:1.2; cursor:pointer; }
  .ai-product-video-feature-{{ ai_gen_id }}__watch:hover,.ai-product-video-feature-{{ ai_gen_id }}__watch:focus-visible { background:{{ block.settings.button_color }}; color:{{ block.settings.button_text_color }}; }
  .ai-product-video-feature-{{ ai_gen_id }}__dialog { position:fixed; inset:0; z-index:2147483000; display:flex; align-items:center; justify-content:center; padding:24px; background:rgba(0,0,0,.78); backdrop-filter:blur(10px); opacity:0; visibility:hidden; transition:opacity .2s ease,visibility .2s ease; }
  .ai-product-video-feature-{{ ai_gen_id }}__dialog.is-open { opacity:1; visibility:visible; }
  .ai-product-video-feature-{{ ai_gen_id }}__dialog video { display:block; width:min(100%,960px); max-height:calc(100vh - 48px); background:#000; }
  .ai-product-video-feature-{{ ai_gen_id }}__close { position:absolute; top:16px; right:16px; width:42px; height:42px; border:1px solid #fff; border-radius:50%; background:#111; color:#fff; font-size:24px; line-height:1; cursor:pointer; }
{% endstyle %}
<product-card-video-{{ ai_gen_id }} class="ai-product-video-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-video-feature-{{ ai_gen_id }}__media">
    {% if card_video != blank %}<video class="ai-product-video-feature-{{ ai_gen_id }}__card-video" autoplay muted loop playsinline aria-hidden="true">{% for source in card_video.sources %}<source src="{{ source.url }}" type="{{ source.mime_type }}">{% endfor %}</video>{% endif %}
  </div>
  {% if popup_video != blank %}
    <button type="button" class="ai-product-video-feature-{{ ai_gen_id }}__watch" aria-controls="{{ video_id }}" aria-haspopup="dialog">▶ {{ block.settings.button_label | escape }}</button>
    <div id="{{ video_id }}" class="ai-product-video-feature-{{ ai_gen_id }}__dialog" role="dialog" aria-modal="true" aria-label="{{ block.settings.dialog_label | escape }}" aria-hidden="true"><button type="button" class="ai-product-video-feature-{{ ai_gen_id }}__close" aria-label="Close video">×</button><video controls preload="metadata">{% for source in popup_video.sources %}<source src="{{ source.url }}" type="{{ source.mime_type }}">{% endfor %}</video></div>
  {% endif %}
</product-card-video-{{ ai_gen_id }}>
{% if popup_video != blank %}<script>(function(){if(customElements.get('product-card-video-{{ ai_gen_id }}'))return;class ProductCardVideo{{ ai_gen_id }} extends HTMLElement{connectedCallback(){if(this.dataset.ready==='true')return;this.dataset.ready='true';this.button=this.querySelector('.ai-product-video-feature-{{ ai_gen_id }}__watch');this.dialog=this.querySelector('.ai-product-video-feature-{{ ai_gen_id }}__dialog');this.video=this.dialog.querySelector('video');this.closeButton=this.dialog.querySelector('.ai-product-video-feature-{{ ai_gen_id }}__close');this.open=this.open.bind(this);this.close=this.close.bind(this);this.onKeydown=this.onKeydown.bind(this);this.button.addEventListener('click',this.open);this.closeButton.addEventListener('click',this.close);this.dialog.addEventListener('click',event=>{if(event.target===this.dialog)this.close()})}open(){this.dialog.classList.add('is-open');this.dialog.setAttribute('aria-hidden','false');document.addEventListener('keydown',this.onKeydown);this.closeButton.focus();this.video.play().catch(function(){})}close(){this.video.pause();this.video.currentTime=0;this.dialog.classList.remove('is-open');this.dialog.setAttribute('aria-hidden','true');document.removeEventListener('keydown',this.onKeydown);this.button.focus()}onKeydown(event){if(event.key==='Escape')this.close()}}customElements.define('product-card-video-{{ ai_gen_id }}',ProductCardVideo{{ ai_gen_id }})})();</script>{% endif %}
{% schema %}{"name":"Product card video","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"text","id":"button_label","label":"Button label","default":"Watch Full Video"},{"type":"text","id":"dialog_label","label":"Dialog label","default":"Product video"},{"type":"range","id":"button_spacing","label":"Button spacing","min":0,"max":30,"step":5,"unit":"px","default":10},{"type":"color","id":"button_color","label":"Button color","default":"#262626"},{"type":"color","id":"button_text_color","label":"Button text color","default":"#ffffff"}],"presets":[{"name":"Product card video"}],"tag":null,"class":"product-card-video-block"}{% endschema %}