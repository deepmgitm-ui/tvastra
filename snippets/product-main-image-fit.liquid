{%- comment -%}
  TVASTRA PDP main image fit.
  Keeps the full source image visible, removes inherited fixed-height cropping,
  and gives the main image the maximum useful width beside the left thumbnail rail.
{%- endcomment -%}
<style>
  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) {
    grid-template-columns: 52px minmax(0, 1fr) !important;
    column-gap: 8px !important;
  }

  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap {
    width: 52px !important;
    max-width: 52px !important;
  }

  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider,
  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main {
    width: 100% !important;
    min-width: 0 !important;
    height: auto !important;
    max-height: none !important;
    min-height: 0 !important;
    overflow: visible !important;
    visibility: visible !important;
    opacity: 1 !important;
    background: #fff !important;
  }

  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-wrapper {
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
  }

  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide,
  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide-active {
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    overflow: visible !important;
  }

  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide .product-media.media-image,
  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide .product-media.media-image > .h-100 {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: auto !important;
    overflow: visible !important;
    background: #fff !important;
  }

  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide .product-media.media-image img,
  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide .product-media.media-image .preview-image,
  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide .product-media.media-image .product-frame-image {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    max-width: 100% !important;
    object-fit: contain !important;
    object-position: center !important;
  }

  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide .media-video,
  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide .media-model,
  .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide .media-fall-back {
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow: visible !important;
  }

  @media (max-width: 767px) {
    .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) {
      grid-template-columns: 46px minmax(0, 1fr) !important;
      column-gap: 6px !important;
    }

    .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap {
      width: 46px !important;
      max-width: 46px !important;
    }

    .main-product-page .product-gallery .mobille-media-slider:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb .swiper-slide {
      width: 46px !important;
      height: 66px !important;
      min-height: 66px !important;
      flex-basis: 66px !important;
    }
  }
</style>
<script>
  (function () {
    'use strict';

    var selector = '.main-product-page .product-gallery .mobille-media-slider';
    var bound = new WeakSet();

    function refresh(gallery) {
      var main = gallery && gallery.querySelector('.product-image-main');
      var swiper = main && main.swiper;
      var images = main && main.querySelectorAll('.product-media.media-image img');

      if (!main) return;

      if (images) {
        images.forEach(function (image) {
          if (!image.complete) {
            image.addEventListener('load', function () {
              refresh(gallery);
            }, { once: true });
          }
        });
      }

      if (swiper) {
        try {
          if (typeof swiper.updateAutoHeight === 'function') swiper.updateAutoHeight(0);
          if (typeof swiper.update === 'function') swiper.update();
        } catch (error) {}
      }
    }

    function bind(gallery) {
      if (!gallery || bound.has(gallery)) return;
      bound.add(gallery);
      refresh(gallery);
      [100, 350, 800, 1600].forEach(function (delay) {
        window.setTimeout(function () { refresh(gallery); }, delay);
      });
    }

    function boot() {
      document.querySelectorAll(selector).forEach(bind);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    if (window.MutationObserver && document.body) {
      var observer = new MutationObserver(function () {
        boot();
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>
