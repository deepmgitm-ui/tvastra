{%- if settings.custom_style != blank -%}
  <style>
    {{- settings.custom_style -}}
  </style>
{%- endif -%}

<style>
  /* Product gallery: main image first, thumbnail carousel below. */
  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider {
    display: flex !important;
    flex-direction: column !important;
    flex-wrap: nowrap !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-main-slider {
    order: 1 !important;
    position: relative !important;
    inset: auto !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap {
    order: 2 !important;
    position: relative !important;
    inset: auto !important;
    top: auto !important;
    right: auto !important;
    bottom: auto !important;
    left: auto !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 14px 0 0 !important;
    padding: 0 14px !important;
    transform: none !important;
    z-index: 2 !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb {
    width: 100% !important;
    margin: 0 !important;
    max-height: none !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-wrapper {
    align-items: center !important;
    justify-content: flex-start !important;
  }

  @media (max-width: 767px) {
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap {
      margin-top: 10px !important;
      padding: 0 14px !important;
      overflow: visible !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb {
      overflow: hidden !important;
      padding: 0 2px 4px !important;
      touch-action: pan-x !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-slide {
      width: clamp(70px, 22vw, 88px) !important;
      height: auto !important;
      flex-shrink: 0 !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-media {
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: 6px;
      background: #f7f7f7;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-media img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
  }

  /* =========================================================
     TVASTRA PDP — SLEEK MARKETPLACE POLISH
     Flipkart-inspired information density and hierarchy.
     Presentation only: product, variant and cart logic untouched.
     ========================================================= */
  :root {
    --tvs-ui-bg: #f1f3f6;
    --tvs-ui-card: #ffffff;
    --tvs-ui-ink: #212121;
    --tvs-ui-muted: #70757a;
    --tvs-ui-line: #e0e0e0;
    --tvs-ui-blue: #2874f0;
    --tvs-ui-blue-soft: #eef4ff;
    --tvs-ui-orange: #ff9f00;
    --tvs-ui-green: #388e3c;
    --tvs-ui-green-soft: #e8f5e9;
    --tvs-ui-yellow-soft: #fffdf0;
  }

  /* PAGE */
  .main-product-page {
    background: var(--tvs-ui-bg) !important;
  }

  .main-product-page .product.row {
    align-items: flex-start !important;
    margin-left: -6px !important;
    margin-right: -6px !important;
  }

  .main-product-page .product-gallery,
  .main-product-page .product-summary {
    padding-left: 6px !important;
    padding-right: 6px !important;
  }

  /* GALLERY */
  .main-product-page .product-gallery .product-main-slider,
  .main-product-page .product-gallery .product-image-main {
    border: 1px solid var(--tvs-ui-line) !important;
    border-radius: 4px !important;
    background: var(--tvs-ui-card) !important;
    box-shadow: none !important;
  }

  .main-product-page .product-gallery .product-image-main .swiper-slide.product__media-item {
    min-height: clamp(420px, 41vw, 560px) !important;
    background: #fff !important;
  }

  .main-product-page .product-gallery .product-image-main .swiper-slide.product__media-item img,
  .main-product-page .product-gallery .product-image-main .swiper-slide.product__media-item picture img {
    width: 100% !important;
    height: 100% !important;
    max-height: 560px !important;
    object-fit: contain !important;
    object-position: center !important;
    padding: 8px !important;
  }

  .main-product-page .product-gallery .product-image-main .product-img-btn {
    top: 10px !important;
    right: 10px !important;
    width: 34px !important;
    height: 34px !important;
    border: 1px solid #d9dfe5 !important;
    border-radius: 4px !important;
    background: rgba(255,255,255,.98) !important;
    color: var(--tvs-ui-ink) !important;
    box-shadow: none !important;
  }

  .main-product-page .product-gallery .product-image-main .swiper-button-prev,
  .main-product-page .product-gallery .product-image-main .swiper-button-next {
    width: 34px !important;
    height: 34px !important;
    margin-top: -17px !important;
    border: 1px solid #d9dfe5 !important;
    border-radius: 4px !important;
    background: rgba(255,255,255,.98) !important;
    color: var(--tvs-ui-ink) !important;
    box-shadow: none !important;
  }

  .main-product-page .product-gallery .product-image-main .swiper-button-prev svg,
  .main-product-page .product-gallery .product-image-main .swiper-button-next svg {
    width: 10px !important;
    height: 16px !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap {
    margin: 8px 0 0 !important;
    padding: 0 !important;
  }

  .main-product-page .product-gallery .product-image-thumb .swiper-wrapper {
    gap: 6px !important;
  }

  .main-product-page .product-gallery .product-image-thumb .swiper-slide {
    width: 64px !important;
    height: 64px !important;
  }

  .main-product-page .product-gallery .product-image-thumb .swiper-slide > * {
    overflow: hidden !important;
    border: 1px solid #d9dfe5 !important;
    border-radius: 3px !important;
    background: #fff !important;
    box-shadow: none !important;
  }

  .main-product-page .product-gallery .product-image-thumb .swiper-slide-thumb-active > * {
    border: 2px solid var(--tvs-ui-blue) !important;
    box-shadow: none !important;
  }

  /* PRODUCT INFO CARD */
  @media (min-width: 992px) {
    .main-product-page .product-summary > .position-sticky {
      position: sticky !important;
      top: 14px !important;
      padding: 0 !important;
      border: 1px solid var(--tvs-ui-line) !important;
      border-radius: 4px !important;
      background: var(--tvs-ui-card) !important;
      box-shadow: none !important;
    }
  }

  .main-product-page .product-summary .product-info {
    padding: 16px !important;
    color: var(--tvs-ui-ink) !important;
    max-width: none !important;
  }

  /* BRAND / TITLE / RATING */
  .main-product-page .product-summary .product-info > .block-name.vendor {
    display: block !important;
    margin: 0 0 4px !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    color: #878787 !important;
    font-size: 9px !important;
    font-weight: 700 !important;
    line-height: 1.3 !important;
    letter-spacing: .04em !important;
    text-transform: uppercase !important;
  }

  .main-product-page .product-summary .product-info .product-title,
  .main-product-page .product-summary .product-info .product-title-share-row > .product-title {
    margin: 0 !important;
    color: var(--tvs-ui-ink) !important;
    font-size: clamp(21px, 1.7vw, 28px) !important;
    font-weight: 600 !important;
    line-height: 1.28 !important;
    letter-spacing: -.01em !important;
  }

  .main-product-page .product-summary .product-info .rating-sku-wrap {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin: 7px 0 0 !important;
  }

  .main-product-page .product-summary .product-info .product-rating {
    display: inline-flex !important;
    min-height: 22px !important;
    align-items: center !important;
    padding: 3px 7px !important;
    border-radius: 3px !important;
    background: var(--tvs-ui-green) !important;
    color: #fff !important;
  }

  .main-product-page .product-summary .product-info .product-rating * {
    color: #fff !important;
  }

  .main-product-page .product-summary .product-info .product-sku {
    padding-left: 8px !important;
    border-left: 1px solid var(--tvs-ui-line) !important;
    color: #878787 !important;
    font-size: 9px !important;
  }

  /* PRICE AREA */
  .main-product-page .product-summary .product-info [id^="price-"] {
    margin: 12px -16px 0 !important;
    padding: 12px 16px !important;
    border-top: 1px solid var(--tvs-ui-line) !important;
    border-bottom: 1px solid var(--tvs-ui-line) !important;
    background: #fff !important;
  }

  .main-product-page .product-summary .product-info [id^="price-"] .price {
    display: flex !important;
    align-items: baseline !important;
    flex-wrap: wrap !important;
    gap: 7px !important;
    color: var(--tvs-ui-ink) !important;
    font-size: 28px !important;
    font-weight: 700 !important;
    line-height: 1 !important;
  }

  .main-product-page .product-summary .product-info [id^="price-"] .price-item--regular,
  .main-product-page .product-summary .product-info [id^="price-"] s {
    color: #878787 !important;
    font-size: 13px !important;
    font-weight: 400 !important;
  }

  .main-product-page .product-summary .product-info [id^="price-"] .price__badge,
  .main-product-page .product-summary .product-info [id^="price-"] .badge {
    padding: 4px 6px !important;
    border-radius: 2px !important;
    background: var(--tvs-ui-green-soft) !important;
    color: var(--tvs-ui-green) !important;
    font-size: 9px !important;
    font-weight: 800 !important;
  }

  .main-product-page .product-summary .product-info .product-purchase-note {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 6px 12px !important;
    margin: 6px 0 0 !important;
    color: var(--tvs-ui-muted) !important;
    font-size: 9px !important;
    font-weight: 600 !important;
  }

  .main-product-page .product-summary .product-info .product-purchase-note span {
    display: inline-flex !important;
    align-items: center !important;
    gap: 5px !important;
  }

  .main-product-page .product-summary .product-info .product-purchase-note span:before {
    content: '✓' !important;
    display: inline-flex !important;
    width: 13px !important;
    height: 13px !important;
    align-items: center !important;
    justify-content: center !important;
    border-radius: 50% !important;
    background: var(--tvs-ui-green-soft) !important;
    color: var(--tvs-ui-green) !important;
    font-size: 8px !important;
    font-weight: 900 !important;
  }

  /* OFFERS */
  .main-product-page .product-summary .product-info .tvastra-product-offers {
    margin: 10px 0 !important;
    overflow: hidden !important;
    border: 1px solid #f1dfaa !important;
    border-radius: 4px !important;
    background: var(--tvs-ui-yellow-soft) !important;
    box-shadow: none !important;
  }

  .main-product-page .product-summary .product-info .tvastra-product-offers__summary {
    min-height: 40px !important;
    padding: 8px 10px !important;
  }

  .main-product-page .product-summary .product-info .tvastra-product-offers__title {
    color: var(--tvs-ui-ink) !important;
    font-size: 10px !important;
    font-weight: 800 !important;
  }

  .main-product-page .product-summary .product-info .tvastra-product-offers__highlight {
    padding: 3px 6px !important;
    border-radius: 2px !important;
    background: #fff1bc !important;
    color: #765719 !important;
    font-size: 8px !important;
    font-weight: 800 !important;
  }

  .main-product-page .product-summary .product-info .tvastra-product-offers__body {
    padding: 0 10px 6px !important;
    border-top: 1px solid #f1dfaa !important;
  }

  .main-product-page .product-summary .product-info .tvastra-product-offer {
    grid-template-columns: 24px minmax(0,1fr) auto !important;
    gap: 7px !important;
    padding: 7px 0 !important;
    border-bottom: 1px dashed #eadfca !important;
  }

  .main-product-page .product-summary .product-info .tvastra-product-offer:last-child {
    border-bottom: 0 !important;
  }

  .main-product-page .product-summary .product-info .tvastra-product-offer__icon {
    width: 24px !important;
    height: 24px !important;
    border-radius: 3px !important;
    background: #fff !important;
    color: #80601a !important;
  }

  .main-product-page .product-summary .product-info .tvastra-product-offer__copy strong {
    font-size: 9px !important;
    font-weight: 800 !important;
  }

  .main-product-page .product-summary .product-info .tvastra-product-offer__copy span {
    margin-top: 2px !important;
    color: #777 !important;
    font-size: 8.5px !important;
    line-height: 1.35 !important;
  }

  .main-product-page .product-summary .product-info .tvastra-product-offer__code {
    padding: 4px 6px !important;
    border: 1px dashed #c4a55a !important;
    border-radius: 2px !important;
    background: #fff !important;
    color: #775816 !important;
    font-size: 8px !important;
    font-weight: 800 !important;
  }

  /* REMOVE DUPLICATE LEGACY COLOUR MODULES */
  .main-product-page .product-summary .product-info [id^="smart-color-swatch-"] {
    display: none !important;
  }

  .main-product-page .product-summary .product-info .color-swatch-box-v2 {
    display: none !important;
  }

  /* COLOUR FAMILY */
  .main-product-page .product-summary .product-info .product-colour-family {
    margin: 10px 0 0 !important;
    padding: 11px 0 0 !important;
    border-top: 1px solid var(--tvs-ui-line) !important;
  }

  .main-product-page .product-summary .product-info .product-colour-family__label {
    margin-bottom: 7px !important;
    color: var(--tvs-ui-ink) !important;
    font-size: 11px !important;
    font-weight: 800 !important;
  }

  .main-product-page .product-summary .product-info .product-colour-family__label span {
    color: var(--tvs-ui-muted) !important;
    font-weight: 500 !important;
  }

  .main-product-page .product-summary .product-info .product-colour-family__options {
    gap: 8px !important;
  }

  .main-product-page .product-summary .product-info .product-colour-family__options > div > div,
  .main-product-page .product-summary .product-info .product-colour-family__options > a > div {
    padding: 2px !important;
    border: 2px solid transparent !important;
  }

  .main-product-page .product-summary .product-info .product-colour-family__options > div > div > span,
  .main-product-page .product-summary .product-info .product-colour-family__options > a > div > span {
    width: 28px !important;
    height: 28px !important;
  }

  .main-product-page .product-summary .product-info .product-colour-family__options > div:first-child > div {
    border-color: var(--tvs-ui-blue) !important;
    box-shadow: 0 0 0 2px #e8efff !important;
  }

  .main-product-page .product-summary .product-info .product-colour-family__options > div > span,
  .main-product-page .product-summary .product-info .product-colour-family__options > a > span {
    color: #777 !important;
    font-size: 8.5px !important;
    font-weight: 600 !important;
  }

  /* VARIANT BOX */
  .main-product-page .product-summary .product-info .product-variants {
    margin: 10px 0 0 !important;
    padding: 11px !important;
    border: 1px solid var(--tvs-ui-line) !important;
    border-radius: 4px !important;
    background: #fff !important;
    box-shadow: none !important;
  }

  .main-product-page .product-summary .product-info .product-filter {
    margin: 0 !important;
    padding: 0 0 10px !important;
    border: 0 !important;
  }

  .main-product-page .product-summary .product-info .product-filter + .product-filter {
    padding-top: 10px !important;
    border-top: 1px solid #ededed !important;
  }

  .main-product-page .product-summary .product-info .product-filter .form-label {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    margin: 0 0 7px !important;
    color: var(--tvs-ui-ink) !important;
    font-size: 10px !important;
    font-weight: 800 !important;
  }

  .main-product-page .product-summary .product-info .product-filter .form-label span {
    color: var(--tvs-ui-blue) !important;
    font-weight: 800 !important;
  }

  .main-product-page .product-summary .product-info .color-filter .variant-option {
    margin: 0 5px 5px 0 !important;
  }

  .main-product-page .product-summary .product-info .color-filter .variant-option label {
    width: 36px !important;
    height: 36px !important;
    padding: 2px !important;
    border: 1px solid #d6dadd !important;
    border-radius: 50% !important;
    background: #fff !important;
  }

  .main-product-page .product-summary .product-info .color-filter .variant-option input:checked + label {
    border: 2px solid var(--tvs-ui-blue) !important;
    box-shadow: 0 0 0 2px #e8efff !important;
  }

  .main-product-page .product-summary .product-info .size-filter {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 6px !important;
  }

  .main-product-page .product-summary .product-info .size-filter .variant-option {
    margin: 0 !important;
  }

  .main-product-page .product-summary .product-info .size-filter .variant-option label {
    display: inline-flex !important;
    min-width: 48px !important;
    height: 36px !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 11px !important;
    border: 1px solid #cfd4d8 !important;
    border-radius: 3px !important;
    background: #fff !important;
    color: var(--tvs-ui-ink) !important;
    font-size: 10px !important;
    font-weight: 700 !important;
  }

  .main-product-page .product-summary .product-info .size-filter .variant-option input:checked + label {
    border-color: var(--tvs-ui-blue) !important;
    background: var(--tvs-ui-blue-soft) !important;
    color: #1d5fc7 !important;
    box-shadow: inset 0 0 0 1px var(--tvs-ui-blue) !important;
  }

  .main-product-page .product-summary .product-info .size-filter .modal-popup {
    margin-left: auto !important;
    color: var(--tvs-ui-blue) !important;
    font-size: 9px !important;
    font-weight: 800 !important;
    text-decoration: underline !important;
    text-underline-offset: 2px !important;
  }

  /* PURCHASE AREA */
  .main-product-page .product-summary .product-info .product-form-buttons {
    margin: 10px 0 0 !important;
    padding: 10px !important;
    border: 1px solid var(--tvs-ui-line) !important;
    border-radius: 4px !important;
    background: #fff !important;
    box-shadow: none !important;
  }

  .main-product-page .product-summary .product-info .quantity-btn label {
    margin-bottom: 4px !important;
    color: var(--tvs-ui-muted) !important;
    font-size: 8px !important;
    font-weight: 800 !important;
    letter-spacing: .05em !important;
    text-transform: uppercase !important;
  }

  .main-product-page .product-summary .product-info .quantity-btn .quantity {
    min-height: 44px !important;
    border: 1px solid #cfd4d8 !important;
    border-radius: 3px !important;
    background: #fff !important;
  }

  .main-product-page .product-summary .product-info .cart-btn {
    min-height: 46px !important;
    border: 0 !important;
    border-radius: 3px !important;
    background: var(--tvs-ui-orange) !important;
    color: #fff !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    letter-spacing: .01em !important;
    box-shadow: none !important;
  }

  .main-product-page .product-summary .product-info .cart-btn:hover {
    background: #f08e00 !important;
    transform: none !important;
  }

  .main-product-page .product-summary .product-info .product-buy-now-inline {
    overflow: hidden !important;
    border-radius: 3px !important;
  }

  .main-product-page .product-summary .product-info .product-buy-now-inline button,
  .main-product-page .product-summary .product-info .product-buy-now-inline .shopify-payment-button__button {
    min-height: 46px !important;
    border: 0 !important;
    border-radius: 3px !important;
    background: var(--tvs-ui-blue) !important;
    color: #fff !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    box-shadow: none !important;
  }

  .main-product-page .product-summary .product-info .product-buy-now-inline button:hover,
  .main-product-page .product-summary .product-info .product-buy-now-inline .shopify-payment-button__button:hover {
    background: #1d63d1 !important;
  }

  .main-product-page .product-summary .product-info .product-form-buttons .wishlist-btn,
  .main-product-page .product-summary .product-info .product-form-buttons .button-wishlist {
    width: 44px !important;
    min-width: 44px !important;
    min-height: 44px !important;
    border: 1px solid #cfd4d8 !important;
    border-radius: 3px !important;
    background: #fff !important;
    color: var(--tvs-ui-ink) !important;
    box-shadow: none !important;
  }

  /* DELIVERY / TRUST / USP */
  .main-product-page .product-summary .product-info .shipping-info,
  .main-product-page .product-summary .product-info .trust-badge,
  .main-product-page .product-summary .product-info .product-usp,
  .main-product-page .product-summary .product-info .product-live-viewers,
  .main-product-page .product-summary .product-info .live-visitors,
  .main-product-page .product-summary .product-info .sold-product-count {
    border: 1px solid var(--tvs-ui-line) !important;
    border-radius: 4px !important;
    box-shadow: none !important;
  }

  .main-product-page .product-summary .product-info .shipping-info {
    margin-top: 8px !important;
    padding: 10px !important;
    background: #fff !important;
  }

  .main-product-page .product-summary .product-info .product-usp {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0,1fr)) !important;
    gap: 5px !important;
    margin-top: 7px !important;
    padding: 7px !important;
    background: var(--tvs-ui-green-soft) !important;
  }

  /* FAQ / LOWER INFO */
  .main-product-page .product-summary .product-info .panel-group {
    margin-top: 8px !important;
