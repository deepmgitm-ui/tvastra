{%- comment -%}
  Desktop PDP gallery layout: thumbnails on the left of the main media.
  Mobile keeps the existing stacked gallery behavior.
{%- endcomment -%}
<style>
  @media (min-width: 768px) {
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider {
      position: relative !important;
      display: block !important;
      width: 100% !important;
      min-width: 0 !important;
      padding: 0 !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider > .product-thumb-wrap {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      bottom: 0 !important;
      z-index: 20 !important;
      width: 76px !important;
      height: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: hidden !important;
      order: initial !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider > .product-main-slider {
      width: calc(100% - 92px) !important;
      max-width: none !important;
      margin: 0 0 0 92px !important;
      padding: 0 !important;
      position: relative !important;
      inset: auto !important;
      order: initial !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb {
      width: 76px !important;
      height: 100% !important;
      max-height: none !important;
      overflow: hidden !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-wrapper {
      display: flex !important;
      flex-direction: column !important;
      align-items: stretch !important;
      justify-content: flex-start !important;
      width: 76px !important;
      height: 100% !important;
      transform: none;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-slide {
      width: 76px !important;
      height: 92px !important;
      min-height: 92px !important;
      flex: 0 0 92px !important;
      margin: 0 0 10px !important;
      padding: 0 !important;
      opacity: .72 !important;
      cursor: pointer !important;
      border: 1px solid transparent !important;
      box-sizing: border-box !important;
      transition: opacity .18s ease, border-color .18s ease !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-slide:hover,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-slide-thumb-active,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-slide.is-active {
      opacity: 1 !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-slide-thumb-active,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-slide.is-active {
      border-color: #202020 !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .product-media {
      width: 100% !important;
      height: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 1px solid #e5e5e5 !important;
      border-radius: 3px !important;
      background: #f7f7f7 !important;
      overflow: hidden !important;
      box-sizing: border-box !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-slide-thumb-active .product-media,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .swiper-slide.is-active .product-media {
      border: 2px solid #202020 !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-thumb-wrap .product-image-thumb .product-media img {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider .product-main-slider .product-image-main {
      width: 100% !important;
      margin: 0 !important;
    }
  }

  @media (max-width: 767px) {
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider {
      display: flex !important;
      flex-direction: column !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider > .product-main-slider {
      width: 100% !important;
      margin: 0 !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider > .product-thumb-wrap {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      margin: 10px 0 0 !important;
      order: 2 !important;
    }
  }
</style>
