{%- comment -%}
  Tvastra PDP gallery: thumbnails stay on the LEFT of the main media
  on desktop and mobile. Existing Swiper, zoom, video and model behavior
  is preserved; this snippet only controls the gallery presentation.
{%- endcomment -%}

<style>
  /* ============================================================
     TVASTRA PDP GALLERY — LEFT THUMB RAIL ON ALL DEVICES
     [ thumbs ] [ main image ]
     ============================================================ */
  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) {
    display: grid !important;
    grid-template-columns: clamp(58px, 6vw, 76px) minmax(0, 1fr) !important;
    grid-template-rows: auto !important;
    grid-template-areas: "thumb main" !important;
    gap: 10px !important;
    align-items: stretch !important;
    width: 100% !important;
    min-width: 0 !important;
    padding: 0 !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap {
    grid-area: thumb !important;
    position: relative !important;
    inset: auto !important;
    width: 100% !important;
    max-width: none !important;
    height: 100% !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    order: 0 !important;
    align-self: stretch !important;
    overflow: hidden !important;
    transform: none !important;
    z-index: 5 !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider {
    grid-area: main !important;
    position: relative !important;
    inset: auto !important;
    width: auto !important;
    max-width: none !important;
    min-width: 0 !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    order: 0 !important;
    align-self: stretch !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap .product-image-thumb {
    width: 100% !important;
    max-width: none !important;
    height: 100% !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap .product-image-thumb .swiper-wrapper {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    justify-content: flex-start !important;
    width: 100% !important;
    height: 100% !important;
    transform: none !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap .product-image-thumb .swiper-slide {
    width: 100% !important;
    height: clamp(64px, 7vw, 88px) !important;
    min-height: clamp(64px, 7vw, 88px) !important;
    flex: 0 0 clamp(64px, 7vw, 88px) !important;
    margin: 0 0 8px !important;
    padding: 0 !important;
    opacity: .72 !important;
    cursor: pointer !important;
    box-sizing: border-box !important;
    transition: opacity .18s ease, transform .18s ease !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap .product-image-thumb .swiper-slide:hover,
  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap .product-image-thumb .swiper-slide-thumb-active,
  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap .product-image-thumb .swiper-slide.is-active {
    opacity: 1 !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap .product-image-thumb .product-media {
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 1px solid #e1e1e1 !important;
    border-radius: 3px !important;
    background: #f7f7f7 !important;
    box-shadow: none !important;
    overflow: hidden !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap .product-image-thumb .swiper-slide-thumb-active .product-media,
  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap .product-image-thumb .swiper-slide.is-active .product-media {
    border: 2px solid #222 !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap .product-image-thumb .product-media img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    object-position: center !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main {
    width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-wrapper {
    width: 100% !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .swiper-slide {
    width: 100% !important;
    min-width: 0 !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .product-media {
    width: 100% !important;
    overflow: hidden !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main .product-media img {
    width: 100% !important;
    object-fit: contain !important;
    object-position: center !important;
  }

  .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-img-btn {
    z-index: 20 !important;
  }
</style>

<script>
  (function () {
    'use strict';

    var STYLE_ID = 'tvastra-pdp-gallery-left-all-devices';
    var gallerySelector = '.main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider';
    var resizeTimer = null;

    function injectFinalStyle() {
      if (document.getElementById(STYLE_ID)) return;

      var style = document.createElement('style');
      style.id = STYLE_ID;
      style.textContent = `
        ${gallerySelector}:has(> .product-thumb-wrap) {
          display:grid !important;
          grid-template-columns:clamp(58px,6vw,76px) minmax(0,1fr) !important;
          grid-template-areas:'thumb main' !important;
          gap:10px !important;
          align-items:stretch !important;
          flex-direction:row !important;
          flex-wrap:nowrap !important;
          width:100% !important;
          min-width:0 !important;
        }
        ${gallerySelector}:has(> .product-thumb-wrap) > .product-thumb-wrap {
          grid-area:thumb !important;
          position:relative !important;
          inset:auto !important;
          width:100% !important;
          max-width:none !important;
          height:100% !important;
          margin:0 !important;
          padding:0 !important;
          order:0 !important;
          overflow:hidden !important;
        }
        ${gallerySelector}:has(> .product-thumb-wrap) > .product-main-slider {
          grid-area:main !important;
          position:relative !important;
          inset:auto !important;
          width:auto !important;
          max-width:none !important;
          min-width:0 !important;
          margin:0 !important;
          padding:0 !important;
          order:0 !important;
        }
        ${gallerySelector}:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb {
          width:100% !important;
          max-width:none !important;
          height:100% !important;
          overflow:hidden !important;
        }
        ${gallerySelector}:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb .swiper-wrapper {
          display:flex !important;
          flex-direction:column !important;
          align-items:stretch !important;
          width:100% !important;
          height:100% !important;
        }
        ${gallerySelector}:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb .swiper-slide {
          width:100% !important;
          height:clamp(64px,7vw,88px) !important;
          min-height:clamp(64px,7vw,88px) !important;
          flex:0 0 clamp(64px,7vw,88px) !important;
          margin:0 0 8px !important;
        }
        ${gallerySelector}:has(> .product-thumb-wrap) > .product-main-slider .product-image-main {
          width:100% !important;
          margin:0 !important;
        }
      `;
      document.body.appendChild(style);
    }

    function syncThumbSwiper() {
      document.querySelectorAll(gallerySelector).forEach(function (gallery) {
        var thumb = gallery.querySelector('.product-image-thumb');
        var swiper = thumb && thumb.swiper;

        gallery.setAttribute('data-gallery-left-rail', 'true');

        if (!swiper) return;

        try {
          if (typeof swiper.changeDirection === 'function') {
            swiper.changeDirection('vertical', false);
          } else if (swiper.params) {
            swiper.params.direction = 'vertical';
          }

          if (swiper.params) {
            swiper.params.slidesPerView = window.innerWidth < 768 ? 4 : 6;
            swiper.params.spaceBetween = window.innerWidth < 768 ? 8 : 10;
            swiper.params.freeMode = false;
            swiper.params.centeredSlides = false;
          }

          if (typeof swiper.update === 'function') swiper.update();
        } catch (error) {}
      });
    }

    function boot() {
      injectFinalStyle();
      syncThumbSwiper();
      window.setTimeout(syncThumbSwiper, 150);
      window.setTimeout(syncThumbSwiper, 500);
      window.setTimeout(syncThumbSwiper, 1200);
      window.setTimeout(syncThumbSwiper, 2200);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    window.addEventListener('resize', function () {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(syncThumbSwiper, 120);
    });

    if (window.MutationObserver && document.body) {
      var observer = new MutationObserver(function () {
        window.setTimeout(syncThumbSwiper, 40);
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>
