{%- comment -%}
  Tvastra PDP gallery: desktop left thumbnail rail.
  Mobile keeps thumbnails below the main image.
  Runtime style is injected after the theme's internal styles so this
  layout cannot be overridden by the older stacked-gallery rules.
{%- endcomment -%}
<style>
  @media (min-width: 768px) {
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail],
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) {
      display: grid !important;
      grid-template-columns: 76px minmax(0, 1fr) !important;
      grid-template-rows: auto !important;
      grid-template-areas: "thumb main" !important;
      column-gap: 12px !important;
      align-items: stretch !important;
      width: 100% !important;
      flex-direction: row !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] > .product-thumb-wrap,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-thumb-wrap {
      grid-area: thumb !important;
      position: relative !important;
      inset: auto !important;
      top: 0 !important;
      right: auto !important;
      bottom: auto !important;
      left: 0 !important;
      z-index: 10 !important;
      width: 76px !important;
      max-width: 76px !important;
      height: 100% !important;
      min-height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      order: 0 !important;
      transform: none !important;
      overflow: hidden !important;
      align-self: stretch !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] > .product-main-slider,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider {
      grid-area: main !important;
      position: relative !important;
      inset: auto !important;
      width: auto !important;
      max-width: none !important;
      min-width: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      order: 0 !important;
      align-self: stretch !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] .product-thumb-wrap .product-image-thumb,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb {
      width: 76px !important;
      max-width: 76px !important;
      height: 100% !important;
      max-height: none !important;
      margin: 0 !important;
      overflow: hidden !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] .product-thumb-wrap .product-image-thumb .swiper-wrapper,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb .swiper-wrapper {
      display: flex !important;
      flex-direction: column !important;
      align-items: stretch !important;
      justify-content: flex-start !important;
      width: 76px !important;
      height: 100% !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] .product-thumb-wrap .product-image-thumb .swiper-slide,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb .swiper-slide {
      width: 76px !important;
      height: 88px !important;
      min-height: 88px !important;
      flex: 0 0 88px !important;
      margin: 0 0 10px !important;
      padding: 0 !important;
      opacity: .72 !important;
      box-sizing: border-box !important;
      cursor: pointer !important;
      transition: opacity .18s ease, border-color .18s ease !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] .product-thumb-wrap .product-image-thumb .swiper-slide:hover,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] .product-thumb-wrap .product-image-thumb .swiper-slide-thumb-active,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb .swiper-slide:hover,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb .swiper-slide-thumb-active {
      opacity: 1 !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] .product-thumb-wrap .product-image-thumb .product-media,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb .product-media {
      width: 76px !important;
      height: 88px !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 1px solid #e2e2e2 !important;
      border-radius: 3px !important;
      background: #f7f7f7 !important;
      box-shadow: none !important;
      overflow: hidden !important;
      box-sizing: border-box !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] .product-thumb-wrap .product-image-thumb .swiper-slide-thumb-active .product-media,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb .swiper-slide-thumb-active .product-media {
      border: 2px solid #202020 !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] .product-thumb-wrap .product-image-thumb .product-media img,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) .product-thumb-wrap .product-image-thumb .product-media img {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider[data-gallery-left-rail] > .product-main-slider .product-image-main,
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider:has(> .product-thumb-wrap) > .product-main-slider .product-image-main {
      width: 100% !important;
      margin: 0 !important;
    }
  }

  @media (max-width: 767px) {
    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider {
      display: flex !important;
      flex-direction: column !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider > .product-main-slider {
      width: 100% !important;
      margin: 0 !important;
      order: 1 !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider > .product-thumb-wrap {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      max-width: 100% !important;
      margin: 10px 0 0 !important;
      padding: 0 10px !important;
      order: 2 !important;
      overflow: visible !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider > .product-thumb-wrap .product-image-thumb {
      width: 100% !important;
      max-width: 100% !important;
      height: auto !important;
      overflow: hidden !important;
      touch-action: pan-x !important;
    }

    .main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider > .product-thumb-wrap .product-image-thumb .swiper-wrapper {
      flex-direction: row !important;
      align-items: stretch !important;
      height: auto !important;
      width: max-content !important;
    }
  }
</style>

<script>
  (function () {
    'use strict';

    var STYLE_ID = 'tvastra-pdp-left-rail-runtime';
    var gallerySelector = '.main-product-page .product-gallery .product-media-grid-wrapper.mobille-media-slider';
    var resizeTimer = null;

    function injectFinalStyle() {
      if (document.getElementById(STYLE_ID)) return;

      var style = document.createElement('style');
      style.id = STYLE_ID;
      style.textContent = `
        @media (min-width: 768px) {
          ${gallerySelector} { display:grid !important; grid-template-columns:76px minmax(0,1fr) !important; grid-template-areas:'thumb main' !important; column-gap:12px !important; align-items:stretch !important; }
          ${gallerySelector} > .product-thumb-wrap { grid-area:thumb !important; position:relative !important; inset:auto !important; width:76px !important; max-width:76px !important; height:100% !important; margin:0 !important; padding:0 !important; order:0 !important; overflow:hidden !important; }
          ${gallerySelector} > .product-main-slider { grid-area:main !important; position:relative !important; inset:auto !important; width:auto !important; max-width:none !important; min-width:0 !important; margin:0 !important; padding:0 !important; order:0 !important; }
          ${gallerySelector} .product-thumb-wrap .product-image-thumb { width:76px !important; max-width:76px !important; height:100% !important; max-height:none !important; overflow:hidden !important; }
          ${gallerySelector} .product-thumb-wrap .product-image-thumb .swiper-wrapper { display:flex !important; flex-direction:column !important; align-items:stretch !important; width:76px !important; height:100% !important; }
          ${gallerySelector} .product-thumb-wrap .product-image-thumb .swiper-slide { width:76px !important; height:88px !important; min-height:88px !important; flex:0 0 88px !important; margin:0 0 10px !important; }
          ${gallerySelector} > .product-main-slider .product-image-main { width:100% !important; margin:0 !important; }
        }
      `;
      document.body.appendChild(style);
    }

    function syncThumbDirection() {
      var mobile = window.innerWidth < 768;

      document.querySelectorAll(gallerySelector).forEach(function (gallery) {
        gallery.setAttribute('data-gallery-left-rail', 'true');

        var thumbElement = gallery.querySelector('.product-image-thumb');
        var thumbSwiper = thumbElement && thumbElement.swiper;

        if (!thumbSwiper) return;

        var nextDirection = mobile ? 'horizontal' : 'vertical';

        try {
          if (typeof thumbSwiper.changeDirection === 'function') {
            thumbSwiper.changeDirection(nextDirection, false);
          } else if (thumbSwiper.params) {
            thumbSwiper.params.direction = nextDirection;
          }

          if (thumbSwiper.params) {
            thumbSwiper.params.slidesPerView = mobile ? 'auto' : 6;
            thumbSwiper.params.spaceBetween = mobile ? 8 : 10;
            thumbSwiper.params.freeMode = mobile
              ? { enabled: true, sticky: false }
              : false;
          }

          if (typeof thumbSwiper.update === 'function') thumbSwiper.update();
        } catch (error) {}
      });
    }

    function boot() {
      injectFinalStyle();
      syncThumbDirection();
      window.setTimeout(syncThumbDirection, 250);
      window.setTimeout(syncThumbDirection, 900);
      window.setTimeout(syncThumbDirection, 1800);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    window.addEventListener('resize', function () {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(syncThumbDirection, 120);
    });

    if (window.MutationObserver) {
      var observer = new MutationObserver(function () {
        window.setTimeout(syncThumbDirection, 60);
      });

      observer.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>
