{%- capture border-style -%}
  {%- if section.settings.show_border == true -%}
    border: 1px solid var(--extra-medium-gray);
  {%- endif -%}
  border-radius: {{ section.settings.image_border_radius }}px;
{%- endcapture -%}

{%- comment -%}
  Stable product gallery media rendering.
  Unlabelled media is intentionally kept visible even when variant grouping is enabled;
  this prevents an empty gallery when Shopify media alt text is blank.
{%- endcomment -%}

{%- if section.settings.show_thumb_slider == true -%}
  <div class="product-thumb-wrap">
    <div class="swiper product-image-thumb slider-vertical">
      <div class="swiper-wrapper">
        {%- for media in product.media -%}
          <div
            class="swiper-slide"
            data-media-id="{{ section_id }}-{{ media.id }}-thumb"
            data-media-type="{{ media.media_type }}"
            data-preview-src="{{ media.preview_image | image_url: width: 1400 }}"
            data-preview-alt="{{ media.alt | escape }}"
            data-index="{{ forloop.index }}"
            variant_img_added=""
          >
            {%- render 'product-thumbnail',
              type: 'thumb',
              media: media,
              position: forloop.index,
              loop: section_settings.enable_video_looping,
              modal_id: section_id,
              border_style: border-style
            -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{%- liquid
  assign initial_media_id = product.selected_or_first_available_variant.featured_media.id
  assign initialSlide = 0
  for media in product.media
    if media.id == initial_media_id
      assign initialSlide = forloop.index0
      break
    endif
  endfor
-%}

<div class="product-main-slider">
  <a
    href="#"
    class="product-gallery-photoswipe__trigger product-img-btn"
    data-original-title="Zoom"
    data-placement="left"
    aria-label="Zoom product media"
  >
    <span class="bi bi-arrows-fullscreen"></span>
  </a>

  <div class="badge-wrapper" id="badge-{{ section_id }}">
    {%- render 'product-badge', product_for_badge: product -%}
  </div>

  {%- capture slider_thumb_options -%}
    {%- if section.settings.show_thumb_slider == true -%}
      "initialSlide":{{ initialSlide }},
      "autoHeight":false,
      "spaceBetween":10,
      "watchOverflow":true,
      "navigation":{
        "nextEl":".product-image-main .swiper-button-next",
        "prevEl":".product-image-main .swiper-button-prev"
      },
      "thumbs":{
        "swiper":{
          "el":".product-image-thumb",
          "slidesPerView":4,
          "direction":"vertical",
          "spaceBetween":10,
          "watchSlidesProgress":true,
          "slideThumbActiveClass":"swiper-slide-thumb-active",
          "navigation":{
            "nextEl":".swiper-button-next.thumb",
            "prevEl":".swiper-button-prev.thumb"
          },
          "breakpoints":{
            "0":{"slidesPerView":4,"spaceBetween":8},
            "768":{"slidesPerView":5,"spaceBetween":10},
            "1200":{"slidesPerView":6,"spaceBetween":10}
          }
        }
      }
    {%- else -%}
      "initialSlide":{{ initialSlide }},
      "autoHeight":false,
      "spaceBetween":10,
      "watchOverflow":true,
      "navigation":{
        "nextEl":".product-image-main .swiper-button-next",
        "prevEl":".product-image-main .swiper-button-prev"
      },
      "breakpoints":{"0":{"slidesPerView":1}}
    {%- endif -%}
  {%- endcapture -%}

  <div
    class="swiper product-image-main"
    data-slider-options='{ {{ slider_thumb_options }} }'
    data-thumb-direction="vertical"
    data-thumb-breakpoint="767"
    style="{{ border-style }}"
  >
    <div class="swiper-wrapper">
      {%- for media in product.media -%}
        <div
          class="swiper-slide product__media-item"
          data-media-type="{{ media.media_type }}"
          data-media-host="{{ media.host }}"
          data-media-id="{{ section_id }}-{{ media.id }}-main"
          data-index="{{ forloop.index }}"
          variant_img_added=""
        >
          {%- render 'product-thumbnail',
            type: 'main',
            media: media,
            position: forloop.index,
            loop: section_settings.enable_video_looping,
            modal_id: section_id
          -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="swiper-button-prev">
      <svg xmlns="http://www.w3.org/2000/svg" fill="#262626" viewBox="0 0 320 512" aria-hidden="true">
        <path d="M41.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 256 246.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
      </svg>
    </div>

    <div class="swiper-button-next">
      <svg xmlns="http://www.w3.org/2000/svg" fill="#262626" viewBox="0 0 320 512" aria-hidden="true">
        <path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"/>
      </svg>
    </div>
  </div>
</div>

<style>
  /* ------------------------------------------------------------------
     Gallery: vertical thumbnail rail on the LEFT at every breakpoint.
     The main media area is a stable stage; media fits inside it.
     ------------------------------------------------------------------ */
  .main-product-page .product-gallery.slider-horizontal .mobille-media-slider {
    display: grid !important;
    grid-template-columns: 68px minmax(0, 1fr) !important;
    grid-template-areas: "thumb main" !important;
    column-gap: 12px !important;
    align-items: stretch !important;
    width: 100% !important;
    min-width: 0 !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-thumb-wrap {
    grid-area: thumb !important;
    width: 68px !important;
    min-width: 68px !important;
    max-width: 68px !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    position: relative !important;
    inset: auto !important;
    order: 0 !important;
    align-self: stretch !important;
    overflow: hidden !important;
    z-index: 4 !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-image-thumb {
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    overflow: hidden !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-image-thumb .swiper-wrapper {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    justify-content: flex-start !important;
    height: 100% !important;
    width: 100% !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-image-thumb .swiper-slide {
    width: 68px !important;
    height: 84px !important;
    min-height: 84px !important;
    max-height: 84px !important;
    flex: 0 0 84px !important;
    margin: 0 0 8px !important;
    padding: 0 !important;
    box-sizing: border-box !important;
    opacity: .72 !important;
    cursor: pointer !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-image-thumb .swiper-slide:hover,
  .main-product-page .product-gallery.slider-horizontal .product-image-thumb .swiper-slide-thumb-active {
    opacity: 1 !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-image-thumb .product-media {
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    border: 1px solid #e6e8ea !important;
    border-radius: 4px !important;
    background: #f7f7f7 !important;
    overflow: hidden !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-image-thumb .swiper-slide-thumb-active .product-media {
    border-color: #1f2326 !important;
    border-width: 2px !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-image-thumb .product-media img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider {
    grid-area: main !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    position: relative !important;
    align-self: stretch !important;
    overflow: visible !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main {
    width: 100% !important;
    height: min(78vh, 720px) !important;
    min-height: 420px !important;
    margin: 0 !important;
    background: #f7f7f7 !important;
    border-radius: 4px !important;
    overflow: hidden !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-wrapper,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide {
    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important;
    max-height: 100% !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: hidden !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .product-media.media-image,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .product-media.media-image > .h-100 {
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    max-height: 100% !important;
    margin: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: #f7f7f7 !important;
    overflow: hidden !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .product-media.media-image img,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .product-media.media-image picture,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .product-media.media-image .preview-image,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .product-media.media-image .product-frame-image {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important;
    object-position: center !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide .media-video,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide .media-model,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide .media-fall-back {
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    max-height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: hidden !important;
    background: #f7f7f7 !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide .media-video > video,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide .media-video .plyr,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide .media-video .plyr__video-wrapper,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide .media-video iframe,
  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide .media-model model-viewer {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide .media-video > video {
    display: block !important;
    object-fit: contain !important;
    object-position: center center !important;
    background: #f7f7f7 !important;
    cursor: pointer !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main .swiper-slide .media-video iframe {
    display: block !important;
    border: 0 !important;
    object-fit: contain !important;
    object-position: center !important;
  }

  .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-img-btn {
    z-index: 30 !important;
  }

  @media (max-width: 767px) {
    .main-product-page .product-gallery.slider-horizontal .mobille-media-slider {
      grid-template-columns: 52px minmax(0, 1fr) !important;
      column-gap: 7px !important;
    }

    .main-product-page .product-gallery.slider-horizontal .product-thumb-wrap,
    .main-product-page .product-gallery.slider-horizontal .product-image-thumb .swiper-slide {
      width: 52px !important;
      min-width: 52px !important;
      max-width: 52px !important;
    }

    .main-product-page .product-gallery.slider-horizontal .product-image-thumb .swiper-slide {
      height: 70px !important;
      min-height: 70px !important;
      max-height: 70px !important;
      flex-basis: 70px !important;
      margin-bottom: 7px !important;
    }

    .main-product-page .product-gallery.slider-horizontal .product-main-slider .product-image-main {
      height: min(72vh, 620px) !important;
      min-height: 360px !important;
    }
  }
</style>
