{%- comment -%}Legacy cart fallback: keep old section renders error-free while the main cart uses the inline version.{%- endcomment -%}
{%- unless cart == empty -%}
  {%- assign tvfit_applied = false -%}
  {%- for discount in cart.cart_level_discount_applications -%}
    {%- assign discount_title = discount.title | upcase -%}
    {%- if discount_title contains 'TVFIT10' -%}
      {%- assign tvfit_applied = true -%}
    {%- endif -%}
  {%- endfor -%}
  <div class="tvastra-cart-price-summary tvastra-cart-price-summary--page tvastra-cart-price-summary--below" data-tvastra-cart-summary="page" aria-label="Price summary">
    <div class="tvastra-cart-price-summary__heading">
      <span>Price details</span>
      <small>{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</small>
    </div>
    <div class="tvastra-cart-price-summary__row">
      <span>Product total</span>
      <strong>{{ cart.original_total_price | money }}</strong>
    </div>
    {%- if cart.total_discount > 0 -%}
      <div class="tvastra-cart-price-summary__row tvastra-cart-price-summary__row--discount">
        <span>Discount{% if tvfit_applied %} (TVFIT10){% endif %}</span>
        <strong>-{{ cart.total_discount | money }}</strong>
      </div>
    {%- else -%}
      <div class="tvastra-cart-price-summary__row tvastra-cart-price-summary__row--muted">
        <span>Discount</span>
        <strong>Not applied</strong>
      </div>
    {%- endif -%}
    <div class="tvastra-cart-price-summary__row">
      <span>Subtotal</span>
      <strong>{{ cart.items_subtotal_price | money }}</strong>
    </div>
    {%- if cart.requires_shipping -%}
      <div class="tvastra-cart-price-summary__row tvastra-cart-price-summary__row--soft">
        <span>Shipping</span>
        <strong>At checkout</strong>
      </div>
    {%- endif -%}
    <div class="tvastra-cart-price-summary__row tvastra-cart-price-summary__row--soft">
      <span>Taxes</span>
      <strong>{% if cart.taxes_included %}Included{% else %}At checkout{% endif %}</strong>
    </div>
    <div class="cart-subtotal alt-font tvastra-cart-price-summary__row tvastra-cart-price-summary__row--total">
      <label class="mb-0">Total</label>
      <span>{{ cart.total_price | money }}</span>
    </div>
    <small class="tvastra-cart-price-summary__note">Extra 5% prepaid offer is applied at payment. Shipping and taxes are confirmed at checkout.</small>
  </div>
{%- endunless -%}

{%- comment -%}Selected cart recommendations are configured with custom.crosssell_products.{%- endcomment -%}
{%- liquid
  assign recommendation_markup = ''
  assign selected_ids = '|'
  assign selected_count = 0

  for cart_item in cart.items
    if settings.cart_recommendation_products != blank
      assign selected_products = settings.cart_recommendation_products
    elsif settings.cart_recommendation_collection != blank
      assign selected_products = settings.cart_recommendation_collection.products
    else
      assign selected_products = cart_item.product.metafields.custom.crosssell_products.value
    endif
    for recommendation in selected_products
      if selected_count >= 6
        break
      endif

      assign recommendation_marker = '|' | append: recommendation.id | append: '|'
      assign already_in_cart = false
      assign already_selected = false
      if selected_ids contains recommendation_marker
        assign already_selected = true
      endif
      for existing_item in cart.items
        if existing_item.product_id == recommendation.id
          assign already_in_cart = true
          break
        endif
      endfor

      if recommendation.available and already_in_cart == false and already_selected == false
        capture recommendation_card
          <a class="tvastra-cart-rec-card" href="{{ recommendation.url }}">
            <div class="tvastra-cart-rec-card__image">
              {%- if recommendation.featured_image -%}
                <img
                  src="{{ recommendation.featured_image | image_url: width: 220 }}"
                  alt="{{ recommendation.featured_image.alt | default: recommendation.title | escape }}"
                  width="110"
                  height="132"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <div class="tvastra-cart-rec-card__body">
              <strong class="tvastra-cart-rec-card__title">{{ recommendation.title | escape }}</strong>
              <span class="tvastra-cart-rec-card__price">
                {{ recommendation.price | money }}
                {%- if recommendation.compare_at_price > recommendation.price -%}
                  <s>{{ recommendation.compare_at_price | money }}</s>
                {%- endif -%}
              </span>
              <span class="tvastra-cart-rec-card__cta">Select size</span>
            </div>
          </a>
        endcapture
        assign recommendation_markup = recommendation_markup | append: recommendation_card
        assign selected_ids = selected_ids | append: recommendation.id | append: '|'
        assign selected_count = selected_count | plus: 1
      endif
    endfor
    if selected_count >= 6
      break
    endif
  endfor
-%}

{%- if recommendation_markup != blank -%}
  <section class="tvastra-cart-recommendations{% if context == 'main-cart' %} tvastra-cart-recommendations--main{% endif %}" data-tvastra-crosssell>
    <div class="tvastra-cart-recommendations__heading">
      <span>Complete your fit</span>
      <small>Selected for your cart</small>
    </div>
    <div class="tvastra-cart-recommendations__track">
      {{ recommendation_markup }}
    </div>
  </section>
{%- endif -%}
