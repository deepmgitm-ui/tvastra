{%- liquid
  assign gender_handles = 'men,women' | split: ','
  assign category_menu_handles = women_menu | append: ',' | append: men_menu | split: ','
-%}

<div class="container tvastra-shop-menu">
  <div class="back-wrapper d-xl-none d-block">{{ menu_title | escape | split: '[' | first }}</div>

  <div class="tvastra-shop-menu__header">
    <div>
      <p class="tvastra-shop-menu__eyebrow">SHOP TVASTRA</p>
      <p class="tvastra-shop-menu__intro">Activewear made for every move.</p>
    </div>
    <a class="tvastra-shop-menu__desktop-all d-none d-xl-inline-flex" href="{{ routes.all_products_collection_url }}">
      View all products <i class="feather-arrow-right" aria-hidden="true"></i>
    </a>
  </div>

  <div class="tvastra-shop-menu__layout">
    <div class="tvastra-shop-menu__gender" aria-label="Shop by gender">
      {%- for gender_handle in gender_handles -%}
        {%- liquid
          assign gender_collection = collections[gender_handle]
          assign gender_image = gender_collection.image | default: gender_collection.products.first.featured_image
        -%}
        {%- if gender_collection != blank -%}
          <a class="tvastra-shop-menu__gender-link" href="{{ gender_collection.url }}">
            <span class="tvastra-shop-menu__gender-media">
              {%- if gender_image != blank -%}
                {{
                  gender_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'tvastra-shop-menu__gender-image',
                    widths: '240, 360, 480, 720, 900',
                    sizes: '(max-width: 767px) 50vw, 320px',
                    loading: 'lazy',
                    alt: gender_collection.title
                }}
              {%- endif -%}
            </span>
            <span class="tvastra-shop-menu__gender-copy">
              <span>{{ gender_collection.title }}</span>
              <i class="feather-arrow-up-right" aria-hidden="true"></i>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="tvastra-shop-menu__categories">
      <p class="tvastra-shop-menu__label">Shop by category</p>
      <div class="tvastra-shop-menu__category-columns">
        {%- for category_menu_handle in category_menu_handles -%}
          {%- assign category_menu = linklists[category_menu_handle] -%}
          {%- if category_menu.links != blank -%}
            <div class="tvastra-shop-menu__category-group">
              <p class="tvastra-shop-menu__category-group-title">{{ category_menu.title }}</p>
              <div class="tvastra-shop-menu__category-grid">
                {%- for navigation_link in category_menu.links -%}
                  {%- if navigation_link.links != blank -%}
                    {%- for category_link in navigation_link.links -%}
                      {%- render 'tvastra-shop-category-item', category_link: category_link -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- render 'tvastra-shop-category-item', category_link: navigation_link -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <a class="tvastra-shop-menu__mobile-all d-xl-none" href="{{ routes.all_products_collection_url }}">
    <span>
      <strong>All products</strong>
      <small>Explore the complete collection</small>
    </span>
    <i class="feather-arrow-right" aria-hidden="true"></i>
  </a>
</div>
