<div class="cart-title d-flex align-items-center" data-cart-title>
  <h6 class="mb-0 alt-font">{{ 'minicart.general.title' | t }}</h6>
  {%- if cart != empty -%}
    <span>
      {{- cart.item_count }}
      {{ 'minicart.general.items' | t -}}
    </span>
  {%- endif -%}
  <span data-cart-notification-close class="ms-auto cart-close-icon feather-x"></span>
</div>
{%- if cart != empty -%}
  {%- assign tvfit_applied = false -%}
  {%- for discount in cart.cart_level_discount_applications -%}
    {%- assign discount_title = discount.title | upcase -%}
    {%- if discount_title contains 'TVFIT10' -%}
      {%- assign tvfit_applied = true -%}
    {%- endif -%}
  {%- endfor -%}
  <div class="mini-cart-progress"></div>
  <div class="free-shipping-goal-section" data-free-shipping-goal-section></div>
  <div class="mini-cart-wrapper d-flex flex-column h-100" data-mini-cart-wrapper>
    <ul class="cart-notification-products">
      {%- for item in cart.items -%}
        {%- assign cart_item_image = item.image | default: item.product.featured_image -%}
        <li
          id="cart-notification-product-{{ item.id }}"
          class="cart-notification-product"
          data-product="{{ item.product_id }}"
          data-itemid="{{ item.id }}"
        >
          {%- if cart_item_image != blank -%}
            <a class="product-image" href="{{ item.url }}" aria-label="link">
              <img src="{{ cart_item_image | image_url: width: 240 }}" alt="{{ cart_item_image.alt | default: item.product.title | escape }}" loading="lazy" width="240" height="300">
            </a>
          {%- endif -%}
          <div class="cart-product-info">
            <div class="product-inner d-flex">
              <a class="product-name alt-font mb-0 me-auto" href="{{ item.url }}" aria-label="title">{{ item.product.title | escape }}</a>
              <a
                data-item="cart-notification-product-{{ item.id }}"
                data-id="{{ item.key }}"
                href="/cart/change.js?id={{ item.key }}&quantity=0"
                class="remove"
                data-item-id="{{ item.id }}"
                data-cart-notification-item-remove
                aria-label="cart"
                ><i class="feather-x-circle"></i
              ></a>
            </div>
            {%- unless item.product.has_only_default_variant -%}
  <div class="tvastra-cart-options">
    {%- for option in item.options_with_values -%}
      <span class="tvastra-cart-option">
        <span class="tvastra-cart-option-label">{{ option.name }}</span>
        <span class="tvastra-cart-option-value">{{ option.value }}</span>
      </span>
    {%- endfor -%}
  </div>
{%- endunless -%}
            <p class="cart-item__error" id="Line-item-error-{{ forloop.index }}">
              <span
                class="cart-item__error-text text-danger {% if forloop.index == 1 %} first-text {% else %} sectondddd{% endif %}"
              ></span>
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-error" viewBox="0 0 13 13">
                <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
              </svg>
            </p>
            <div class="d-flex align-items-center quantity-wrap">
              <span class="amount alt-font me-auto">{{ item.final_price | money }}</span>
              <quantity-input class="quantity"> 
                <button
                  class="quantity-button quantity-minus feather-minus"
                  name="minus"
                  type="button"
                  aria-label="minus"
                ><span class="visually-hidden">-</span></button>  
                <input
                  class="quantity-input"
                  type="number"
                  name="quantity"
                  min="0"
                  value="{{ item.quantity }}"
                  data-id="{{ item.key }}"
                  id="quantity-input-{{ forloop.index }}"
                >
                <label for="quantity-input" class="visually-hidden"></label> 
                <button
                  id="quantity-input"
                  class="quantity-button quantity-plus feather-plus"
                  name="plus"
                  type="button"
                  aria-label="plus"
                ><span class="visually-hidden">+</span></button> 
              </quantity-input>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>    
    <div class="cart-notification-ymal" id="cart-notification-crosssell-products" data-crosssell_type="selection">
      <!-- Content from cart-notification-crosssell-products.liquid section will be render here -->
    </div>
  </div>
  <div class="mini-cart-bottom" data-cart-bottom>
    <div class="tvastra-cart-offer" data-tvastra-promo>
      <div class="tvastra-cart-offer__copy">
        <span class="tvastra-cart-offer__eyebrow">Welcome offer</span>
        <strong>Extra 10% off available</strong>
        <small>{% if tvfit_applied %}TVFIT10 applied. Your cart total is updated.{% else %}Apply here and see the real saving in your cart.{% endif %}</small>
        <small class="tvastra-cart-offer__prepaid">+5% extra off on prepaid orders.</small>
      </div>
      <div class="tvastra-cart-offer__actions">
        <button type="button" class="tvastra-cart-offer__code" data-tvastra-copy-code="TVFIT10" aria-label="Copy discount code TVFIT10">TVFIT10</button>
        {%- if tvfit_applied -%}
          <button type="button" class="tvastra-cart-offer__remove" data-tvastra-remove-code="TVFIT10" aria-label="Remove discount code TVFIT10">Remove</button>
        {%- else -%}
          <a class="tvastra-cart-offer__apply" data-tvastra-apply-code href="{{ routes.root_url }}discount/TVFIT10?redirect=/cart">Apply</a>
        {%- endif -%}
      </div>
    </div>
      {%- render 'cart-notification-addon' -%}
      <div class="cart-notification-totals-wrapper alt-font">
        <div class="tvastra-cart-price-summary" aria-label="Price summary">
          <div class="tvastra-cart-price-summary__row">
            <span>Subtotal</span>
            <strong>{{ cart.original_total_price | money }}</strong>
          </div>
          {%- if cart.total_discount > 0 -%}
            <div class="tvastra-cart-price-summary__row tvastra-cart-price-summary__row--discount">
              <span>Discount{% if tvfit_applied %} (TVFIT10){% endif %}</span>
              <strong>-{{ cart.total_discount | money }}</strong>
            </div>
          {%- endif -%}
          <div class="tvastra-cart-price-summary__row tvastra-cart-price-summary__row--total">
            <span>Total</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <small class="tvastra-cart-price-summary__note">Extra 5% prepaid offer is applied at payment.</small>
        </div>
      </div>
      {%- if settings.show_terms_conditions == true -%}
        <div class="cart-agreement d-flex">
          <input
            type="checkbox"
            id="terms_agreement_minicart"
            name="terms_agreement"
            value="yes"
            form="form-minicart"
            required
            autocomplete="off"
            data-terms-trigger="minicart"
          >
          <label for="terms_agreement_minicart">
            {{- settings.terms_conditions_label | default: 'I agree with the Terms & Conditions' -}}
          </label>
        </div>
      {%- endif -%}
      <div class="cart-notification-buttons-wrapper">
        <form action="{{ routes.cart_url }}" method="post" id="form-minicart">
          {%- if tvfit_applied -%}<input type="hidden" name="discount" value="TVFIT10">{%- endif -%}
          <button
            class="btn btn-medium btn-black w-100"
            name="checkout"
            form="form-minicart"
            autocomplete="off"
            {%- if settings.show_terms_conditions == true -%}
              disabled="disabled" data-terms-action="minicart"
            {%- endif -%}
          >
            {{ 'minicart.general.checkout' | t }}
          </button>
        </form>
        <a href="{{ routes.cart_url }}" class="btn btn-medium btn-black-border w-100" aria-label="{{ 'minicart.general.view' | t }}">
          {{ 'minicart.general.view' | t }}
        </a>
      </div>
    </div>
  <div class="mini-cart-overlay"></div>
{%- else -%}
  <div class="empty-mini-cart d-flex flex-column align-items-center">
    <i class="feather-shopping-cart"></i><span>{{ 'minicart.general.empty' | t }}</span>
    <a href="/collections/all" class="btn btn-small btn-black" aria-label="{{ 'minicart.general.continue' | t }}">
      {{ 'minicart.general.continue' | t }}
    </a>
  </div>
{%- endif -%}
