<section class="tvastra-confidence" aria-labelledby="TvastraConfidence-{{ section.id }}">
  <div class="container">
    <div class="tvastra-confidence__layout">
      <header class="tvastra-confidence__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tvastra-confidence__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="TvastraConfidence-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </header>

      <div class="tvastra-confidence__items" role="list">
        {%- for block in section.blocks -%}
          <div class="tvastra-confidence__item" role="listitem" {{ block.shopify_attributes }}>
            <p class="tvastra-confidence__item-title">{{ block.settings.title }}</p>
            {%- if block.settings.text != blank -%}
              <p class="tvastra-confidence__item-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  .tvastra-confidence {
    background: #f5f4ef;
    color: #102f34;
    padding: 42px 0;
  }

  .tvastra-confidence__layout {
    display: grid;
    grid-template-columns: minmax(190px, 0.8fr) minmax(0, 2.2fr);
    align-items: center;
    gap: 40px;
  }

  .tvastra-confidence__eyebrow {
    margin: 0 0 7px;
    color: #7d6a4e;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  .tvastra-confidence__intro h2 {
    max-width: 265px;
    margin: 0;
    color: #102f34;
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.22;
  }

  .tvastra-confidence__items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .tvastra-confidence__item {
    min-width: 0;
    padding: 2px 20px;
    border-left: 1px solid rgba(16, 47, 52, 0.16);
  }

  .tvastra-confidence__item-title,
  .tvastra-confidence__item-text {
    margin: 0;
  }

  .tvastra-confidence__item-title {
    color: #102f34;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
  }

  .tvastra-confidence__item-text {
    margin-top: 4px;
    color: #5b6665;
    font-size: 11px;
    line-height: 1.45;
  }

  @media (max-width: 991px) {
    .tvastra-confidence {
      padding: 30px 0;
    }

    .tvastra-confidence__layout {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .tvastra-confidence__intro h2 {
      max-width: 330px;
      font-size: 20px;
    }

    .tvastra-confidence__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 1px solid rgba(16, 47, 52, 0.16);
    }

    .tvastra-confidence__item {
      padding: 15px 12px 13px 0;
      border-bottom: 1px solid rgba(16, 47, 52, 0.16);
    }

    .tvastra-confidence__item:nth-child(even) {
      padding-right: 0;
      padding-left: 12px;
      border-left: 1px solid rgba(16, 47, 52, 0.16);
    }
  }
</style>

{% schema %}
{
  "name": "Tvastra confidence",
  "tag": "section",
  "class": "tvastra-confidence-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOP WITH CONFIDENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for movement. Backed by the details."
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Confidence point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Secure payments"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text",
          "default": "A protected checkout."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tvastra confidence",
      "blocks": [
        { "type": "point", "settings": { "title": "Made in India", "text": "Designed for everyday movement." } },
        { "type": "point", "settings": { "title": "Secure payments", "text": "A protected checkout, every time." } },
        { "type": "point", "settings": { "title": "Easy exchange", "text": "7 days to find your right fit." } },
        { "type": "point", "settings": { "title": "Free prepaid shipping", "text": "Across India, on prepaid orders." } }
      ]
    }
  ]
}
{% endschema %}
